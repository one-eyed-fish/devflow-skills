{
  "name": "devopsflow",
  "version": "0.2.36",
  "type": "module",
  "license": "GPL-3.0-only",
  "private": false,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:skill-eof": "bun scripts/ensure-skill-eof.ts",
    "check:skill-versions": "bun scripts/check-staged-skill-versions.ts",
    "check:skill-metadata": "bun scripts/check-skill-metadata.ts",
    "sync:versions:staged": "bun scripts/sync-staged-versions.ts",
    "test": "bun test",
    "test:repository-scripts": "bun test scripts/",
    "test:validators": "bun test skills/df-dev-tdd/scripts/ skills/df-ddd-event-storming-design/scripts/ skills/df-iam-access-control-design/scripts/",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "format:markdown": "bun scripts/format-markdown-codeblocks.ts",
    "format:markdown:staged": "bun scripts/format-markdown-codeblocks.ts --staged",
    "format:markdown:write": "bun scripts/format-markdown-codeblocks.ts --write",
    "lint": "bunx biome check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
